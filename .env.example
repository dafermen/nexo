# Copiar a .env. No publicar este archivo con credenciales reales.
PORT=3000
AI_PROVIDER=demo
# Para IA real: AI_PROVIDER=openai, clave propia y modelo habilitado en tu cuenta.
OPENAI_API_KEY=
OPENAI_MODEL=
# Administración desactivada si no hay un token de al menos 24 caracteres.
ADMIN_TOKEN=
DB_PATH=./data/kiosk.sqlite
# Etapa 1: iPad + LiveAvatar bajo demanda; etapa 2: MetaHuman.
AVATAR_PROVIDER=liveavatar
LIVEAVATAR_MODE=LITE
# Solo el responsable habilita sesiones que consumen créditos.
LIVEAVATAR_ALLOW_PAID=false
LIVEAVATAR_MAX_SECONDS=60
# Opcional: origen HTTPS exacto del proxy para probar en iPad, sin barra final.
PUBLIC_ORIGIN=
# Cuenta LiveAvatar independiente; LITE no requiere VOICE_ID.
# LIVEAVATAR_AVATAR_ID: ID de la recepcionista elegida/creada en esa cuenta.
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=

# Perfil comercial de la escuela; omitir para conservar el catálogo demo.
CENTER_PROFILE=metodomogollon

# Límites compartidos del filtro escolar; el día usa hora de Nueva York.
AI_SESSION_MAX_CALLS=6
AI_DAILY_MAX_CALLS=100

# CENTER_PROFILE=general para otro negocio: inicia un catálogo comercial vacío.
# Tras guardar /settings, modelo, cuotas e IDs de avatar se administran en ese módulo.
# Las claves y opciones de infraestructura siguen en este archivo de configuración.

# Correo administrativo: remitente y destinatario en config/installation.json.
# Contraseña de aplicación Gmail/SMTP; no es su contraseña habitual de Google.
SMTP_PASSWORD=

# Historial de conversaciones: 0 conserva sin eliminación automática; 1-3650 fija días.
CONVERSATION_RETENTION_DAYS=0

# Google Calendar: cliente OAuth de Aplicación web (Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Retorno por defecto: http://localhost:3000/api/calendar/oauth/callback
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback
# Clave de cifrado creada localmente al autorizar; respalde junto con SQLite.
# GOOGLE_TOKEN_KEY_PATH=.local/google-calendar.key

# Biblioteca de audios aprobados. Piper sigue siendo local.
AUDIO_CACHE_ENABLED=true
AUDIO_CACHE_MAX_MB=128
AUDIO_CACHE_TTL_DAYS=30

# Despliegue VPS: usar deploy/pilot.env.example y docs/45-despliegue-piloto-linux.md.
# Local conserva el acceso de desarrollo. Pilot mantiene las protecciones HTTPS del VPS.
DEPLOYMENT_MODE=local
# Si se omite: true en modo pilot, false en local. Habilitar requiere PUBLIC_ORIGIN HTTPS.
# false abre el kiosco a visitantes; no abre la administración.
PILOT_PRIVATE_ENABLED=false
# Clave de 16–256 caracteres entre comillas. Reiniciar tras modificarla.
# No vacía prevalece sobre PILOT_PASSWORD_HASH; vacía conserva el hash anterior.
PILOT_PASSWORD=
LIVEAVATAR_DAILY_MAX_SESSIONS=100
MAX_ACTIVE_SESSIONS=50
# INSTALLATION_PATH=/etc/nexo/installation.json
# PILOT_PASSWORD_HASH= (generar con scripts/create-pilot-access.js)
# Linux: ejecutar Piper instalado en un entorno Python aislado.
# PIPER_EXECUTABLE=/opt/nexo/piper/bin/piper
# PIPER_VOICES_DIR=/opt/nexo/voices
# PIPER_ENGINE_VERSION=piper-tts-1.4.1
