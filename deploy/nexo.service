# Nexo en Ubuntu 24.04. Código y voces propiedad de root; solo /var/lib/nexo es escribible.
[Unit]
Description=Nexo private web pilot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nexo
Group=nexo
WorkingDirectory=/opt/nexo/current
EnvironmentFile=/etc/nexo/nexo.env
Environment=NODE_ENV=production
ExecStart=/opt/node/bin/node server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/nexo
MemoryMax=2G
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
