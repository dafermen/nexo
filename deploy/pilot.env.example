# Copiar a /etc/nexo/nexo.env (root:nexo, 0640). Sin secretos reales en el paquete.
DEPLOYMENT_MODE=pilot
PORT=3000
PUBLIC_ORIGIN=https://piloto.example.com
CENTER_PROFILE=metodomogollon
INSTALLATION_PATH=/etc/nexo/installation.json
DB_PATH=/var/lib/nexo/kiosk.sqlite
GOOGLE_TOKEN_KEY_PATH=/var/lib/nexo/google-calendar.key
# true: exige clave a participantes. false: kiosco público; administración sigue protegida.
PILOT_PRIVATE_ENABLED=true
# Clave de 16–256 caracteres. Entre comillas para preservar espacios y #.
# Si no está vacía, prevalece sobre PILOT_PASSWORD_HASH. Reiniciar Nexo al cambiar.
PILOT_PASSWORD=
# Alternativa: verificador generado por scripts/create-pilot-access.js.
PILOT_PASSWORD_HASH=
SMTP_PASSWORD=
AI_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=
AI_SESSION_MAX_CALLS=6
AI_DAILY_MAX_CALLS=100
MAX_ACTIVE_SESSIONS=50
CONVERSATION_RETENTION_DAYS=7
AVATAR_PROVIDER=liveavatar
LIVEAVATAR_MODE=LITE
LIVEAVATAR_ALLOW_PAID=false
LIVEAVATAR_MAX_SECONDS=60
LIVEAVATAR_DAILY_MAX_SESSIONS=5
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# El retorno HTTPS se calcula desde PUBLIC_ORIGIN; registrarlo también en Google Cloud.
PIPER_EXECUTABLE=/opt/nexo/piper/bin/piper
PIPER_VOICES_DIR=/opt/nexo/voices
PIPER_VOICE_PROFILE=male
PIPER_ENGINE_VERSION=piper-tts-1.4.1
AUDIO_CACHE_ENABLED=true
AUDIO_CACHE_MAX_MB=128
AUDIO_CACHE_TTL_DAYS=30
